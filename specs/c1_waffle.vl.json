{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C1 Waffle chart. Of every 100 domestic applicants for a Commonwealth supported undergraduate place in semester 1 2025, 85 received an offer. Source: Department of Education, Undergraduate Applications and Offers 2025, Table A2.",
  "title": {
    "text": "85 in every 100 applicants get an offer",
    "subtitle": ["Domestic applicants for undergraduate places, semester 1 2025"]
  },
  "width": 300,
  "height": 300,

  "data": { "url": "data/a2_groups_by_state_2025.csv" },

  "transform": [
    { "filter": "datum.state === 'Australia' && datum.dimension === 'Year 12 status'" },
    {
      "aggregate": [
        { "op": "sum", "field": "applicants", "as": "applicants" },
        { "op": "sum", "field": "offers", "as": "offers" }
      ]
    },
    { "calculate": "sequence(0, 100)", "as": "i" },
    { "flatten": ["i"] },

    { "calculate": "round(100 * datum.offers / datum.applicants)", "as": "offerSquares" },
    { "calculate": "floor(datum.i / 10)", "as": "row" },
    { "calculate": "datum.i % 10", "as": "col" },
    {
      "calculate": "datum.i < datum.offerSquares ? 'Offered a place' : 'No offer'",
      "as": "outcome"
    },
    {
      "calculate": "datum.outcome === 'Offered a place' ? format(datum.offers, ',') + ' applicants (' + format(datum.offers / datum.applicants, '.1%') + ')' : format(datum.applicants - datum.offers, ',') + ' applicants (' + format(1 - datum.offers / datum.applicants, '.1%') + ')'",
      "as": "detail"
    }
  ],

  "params": [
    {
      "name": "hover",
      "select": { "type": "point", "fields": ["outcome"], "on": "pointerover", "clear": "pointerout" }
    }
  ],

  "mark": { "type": "rect", "stroke": "#F7F8F5", "strokeWidth": 3, "cornerRadius": 2, "cursor": "default" },

  "encoding": {
    "x": { "field": "col", "type": "ordinal", "axis": null },
    "y": { "field": "row", "type": "ordinal", "axis": null },
    "color": {
      "field": "outcome",
      "type": "nominal",
      "scale": { "domain": ["Offered a place", "No offer"], "range": ["#1F6F8B", "#C9D2D9"] },
      "legend": { "orient": "bottom", "title": null, "direction": "horizontal" }
    },
    "opacity": {
      "condition": { "param": "hover", "empty": true, "value": 1 },
      "value": 0.35
    },
    "tooltip": [
      { "field": "outcome", "title": "Outcome" },
      { "field": "detail", "title": "Nationally" }
    ]
  }
}